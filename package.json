{
  "name": "nanoclaw-st-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && node dist/src/main.js",
    "start:model": "pnpm build && node --env-file=.env dist/src/main.js",
    "test": "pnpm build && AI_PROVIDER=local node --test dist/test/*.test.js",
    "container:build": "pnpm build && docker build -t nanoclaw-st-agent:lesson14 -f container/Dockerfile .",
    "test:container": "pnpm build && AI_PROVIDER=local node --test dist/test/integration/*.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0"
  }
}
